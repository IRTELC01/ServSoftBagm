JWT_SECRET=supersecreto_cambia_esto
PORT=3001

# Base de datos (usar Postgres para producción)
DB_DRIVER=pg
DATABASE_URL=postgresql://servsoft:servsoft@localhost:5432/servsoftbagm

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: https://servsoftbagm-cliente.onrender.com,https://preview-servsoftbagm-cliente.onrender.com
FRONTEND_ORIGIN=

# Acceso sin login (CORS abierto a cualquier origen + auth deshabilitado).
# SOLO para demo. En producción real: OPEN_ACCESS=false (obligatorio).
OPEN_ACCESS=false

# WhatsApp Cloud API
# Token de acceso de la app (Meta)
WHATSAPP_TOKEN=
# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificación del webhook (elige una cadena segura y configúrala en Meta)
WHATSAPP_VERIFY_TOKEN=cambia_este_token_de_verificacion

# Directorio local de datos (SQLite, archivos)
# En Windows se recomienda algo como: C:\\Users\\TU_USUARIO\\Documents\\ServSoftBagm
DATA_DIR=

# Acceso maestro y alertas
MASTER_USERNAME=bagm
MASTER_PASSWORD=
MASTER_ENABLE=false
ALERT_EMAIL=
# SMTP (para enviar correo). Para Gmail usa App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contraseña por defecto del usuario admin (se fuerza al iniciar el servidor).
# En producción: define una contraseña fuerte y única, nunca uses este placeholder.
DEFAULT_ADMIN_PASSWORD=cambia_esto_por_una_contrasena_fuerte
# Si es 'true', reinicia la contraseña del admin al iniciar
RESET_ADMIN_PASSWORD_ON_START=false
