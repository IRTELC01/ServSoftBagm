# Copia este archivo como .env (desarrollo local) y rellena con los datos reales.
# NUNCA commitees el .env real: contiene datos bancarios y de cédula personales.

# Datos de la cuenta bancaria mostrados en el Panel Administrativo
VITE_BANK_NAME=TuBanco
VITE_BANK_ACCOUNT_TYPE=Ahorros
VITE_BANK_ACCOUNT_NUMBER=000-000000-00
VITE_BANK_HOLDER_NAME=Nombre Apellido
VITE_BANK_HOLDER_ID=00000000
VITE_BANK_INSTRUCTIONS=Realiza la transferencia y envía el comprobante por WhatsApp.

# QR Bancario — URL externa de la imagen del código QR.
# En Render, QRBanco.jpeg está gitignoreado y no existe en el build.
# Sube la imagen a un servicio (imgur, CDN, etc.) y pega la URL aquí.
# Si se omite, el Dashboard usa /assets/bank/QRBanco.jpeg (solo funciona local).
# VITE_BANK_QR_URL=https://i.imgur.com/tuQRBanco.jpeg
