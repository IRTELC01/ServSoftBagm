# Copia este archivo como .env.production o configura las variables en Render/Railway
# URL del backend (IMPORTANTE: debe terminar en /api)
VITE_API_URL=https://tu-api.onrender.com/api

# false = obliga login (obligatorio en producción real)
# true = acceso público sin login (solo demo / pruebas rápidas, nunca en producción)
VITE_OPEN_ACCESS=false